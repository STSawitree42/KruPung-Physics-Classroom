{
  "name": "wave-adventure-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "WAVE ADVENTURE ONLINE — การผจญภัยในโลกคลื่น: บอร์ดเกมฟิสิกส์ออนไลน์หลายผู้เล่น ม.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false && npm --prefix functions run typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "emulators": "firebase emulators:start --project demo-wave-adventure",
    "test:integration": "firebase emulators:exec --project demo-wave-adventure --only auth,database,functions \"vitest run --config vitest.integration.config.ts\"",
    "test:e2e": "node tests/e2e/run-e2e.mjs"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.18.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^14.20.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
