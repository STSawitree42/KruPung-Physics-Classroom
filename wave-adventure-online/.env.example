# =========================================================
# ค่าการเชื่อมต่อ Firebase (Frontend) — ใส่ใน Netlify → Environment variables
# (หรือคัดลอกเป็นไฟล์ .env.local เพื่อทดสอบในเครื่อง)
# ค่าเหล่านี้เป็น "ตัวระบุโปรเจกต์" ที่ออกแบบมาให้อยู่ใน Frontend ได้ (ไม่ใช่รหัสลับ)
# ความปลอดภัยของข้อมูลมาจาก Security Rules (database.rules.json)
# ใช้ Firebase แพ็กเกจฟรี Spark — ไม่ต้องผูกบัตร ดูวิธีหาค่าใน FIREBASE_SETUP.md
# =========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_APP_ID=

# (ไม่บังคับ) URL /exec ของ Apps Script ระบบห้องเรียนออนไลน์ — ใช้เข้าสู่ระบบด้วยเลขประจำตัว + PIN
VITE_SCHOOL_API_URL=

# ใช้ Firebase Emulator ในเครื่อง (ทดสอบ) — ตั้งเป็น true เฉพาะตอนพัฒนา
VITE_USE_EMULATORS=false

# ---------------------------------------------------------
# ห้ามใส่ Database secret ที่นี่! Database secret ใส่ใน Apps Script
# (Script properties: WAVE_DB_URL, WAVE_DB_SECRET, WAVE_API_KEY) เท่านั้น
# =========================================================
