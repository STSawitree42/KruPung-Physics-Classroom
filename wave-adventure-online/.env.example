# =========================================================
# ค่าการเชื่อมต่อ Firebase (Frontend) — คัดลอกเป็นไฟล์ .env.local แล้วใส่ค่าจริง
# ค่าเหล่านี้เป็น "ตัวระบุโปรเจกต์" ที่ออกแบบมาให้อยู่ใน Frontend ได้ (ไม่ใช่รหัสลับ)
# ความปลอดภัยของข้อมูลมาจาก Security Rules และ Cloud Functions
# ดูวิธีหาค่าใน FIREBASE_SETUP.md
# =========================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_REGION=asia-southeast1

# ใช้ Firebase Emulator ในเครื่อง (ทดสอบ) — ตั้งเป็น true เฉพาะตอนพัฒนา
VITE_USE_EMULATORS=false

# ---------------------------------------------------------
# ค่าฝั่ง Cloud Functions (ตั้งใน functions/.env.<project-id> ไม่ใช่ไฟล์นี้)
#   TEACHER_EMAILS=sawitree@yingyuad.ac.th          อีเมลครูที่มีสิทธิ์ (คั่นด้วยจุลภาค)
#   SCHOOL_API_URL=https://script.google.com/macros/s/XXXX/exec   (ไม่บังคับ)
# =========================================================
